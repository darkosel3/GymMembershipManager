<Window x:Class="GymMembershipManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:GymMembershipManager.Services"
        xmlns:local="clr-namespace:GymMembershipManager"
        mc:Ignorable="d"
        FontSize="16"
        Title="Gym Membership Manager" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#f5f6fa">
    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1c6ea4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#bdc3c7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#e74c3c"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#c0392b"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#a93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#7f8c8d"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#636e72"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#535c60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#27ae60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#219a52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1e8449"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#f8f9fa"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#eee"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2c3e50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#34495e"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Padding" Value="0,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#d4e6f1"/>
                    <Setter Property="Foreground" Value="#2c3e50"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#eaf2f8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#2c3e50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="#555"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#2c3e50"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl Background="Transparent">

            <TabItem Header="Dashboard" Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding DashboardViewModel}" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Pregled teretane" Style="{StaticResource SectionTitle}"/>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" BorderBrush="#3498db" BorderThickness="0,0,0,3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Ukupno članova" FontSize="13" Foreground="#888"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalMembers}" FontSize="36" FontWeight="Bold"
                                           Foreground="#2c3e50" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" BorderBrush="#27ae60" BorderThickness="0,0,0,3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Aktivne članarine" FontSize="13" Foreground="#888"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveMemberships}" FontSize="36" FontWeight="Bold"
                                           Foreground="#27ae60" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" BorderBrush="#e74c3c" BorderThickness="0,0,0,3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Istekle članarine" FontSize="13" Foreground="#888"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ExpiredMemberships}" FontSize="36" FontWeight="Bold"
                                           Foreground="#e74c3c" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}" BorderBrush="#9b59b6" BorderThickness="0,0,0,3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Ukupan prihod" FontSize="13" Foreground="#888"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} RSD}" FontSize="30"
                                           FontWeight="Bold" Foreground="#8e44ad" HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" BorderBrush="#3498db" BorderThickness="0,0,0,3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Oprema ukupno" FontSize="13" Foreground="#888"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalEquipment}" FontSize="36" FontWeight="Bold"
                                           Foreground="#2c3e50" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" BorderBrush="#e67e22" BorderThickness="0,0,0,3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Treba servis" FontSize="13" Foreground="#888"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EquipmentNeedingMaintenance}" FontSize="36" FontWeight="Bold"
                                           Foreground="#e67e22" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="{Binding MostPopularType, StringFormat='⭐ Najpopularniji tip: {0}'}"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#2c3e50"/>
                            <DataGrid ItemsSource="{Binding RevenueByType}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tip članarine" Binding="{Binding TypeName}" Width="*"/>
                                    <DataGridTextColumn Header="Broj" Binding="{Binding Count}" Width="100"/>
                                    <DataGridTextColumn Header="Prihod (RSD)" Binding="{Binding Revenue, StringFormat=N0}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="4" Content="🔄 Osveži" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Članovi">
                <Grid DataContext="{Binding MemberViewModel}" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" IsEditable="True" x:Name="MemberSearchBox"
                                      IsTextSearchCaseSensitive="True" IsTextSearchEnabled="False"
                                      Width="400" Height="38" HorizontalAlignment="Left"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding MembersView}"
                                      DisplayMemberPath="FullName"
                                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedItem="{Binding SelectedMember}"
                                      IsDropDownOpen="{Binding IsDropDownOpen}"
                                      FontSize="14"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Obriši člana" Command="{Binding DeleteMemberCommand}"
                                        Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                                <Button Content="Izmeni člana" Command="{Binding OpenEditMemberWindowCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Dodaj člana" Command="{Binding OpenAddMemberWindowCommand}"
                                        Style="{StaticResource SuccessButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Export JSON" Command="{Binding ExportJsonCommand}"
                                    Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                            <Button Content="Import JSON" Command="{Binding ImportJsonCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                            <Button Content="Export XML" Command="{Binding ExportXmlCommand}"
                                    Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                            <Button Content="Import XML" Command="{Binding ImportXmlCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                            <Button Content="📄 PDF izveštaj" Command="{Binding ExportPdfCommand}"
                                    Style="{StaticResource SuccessButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="15">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <Button Content="◀" Command="{Binding PreviousYearCommand}"
                                            Style="{StaticResource SecondaryButton}" Width="45" Height="38" Padding="0"/>
                                    <TextBlock Text="{Binding CurrentYear}"
                                               FontSize="24" FontWeight="Bold" Margin="15,0"
                                               VerticalAlignment="Center" Foreground="#2c3e50"/>
                                    <Button Content="▶" Command="{Binding NextYearCommand}"
                                            Style="{StaticResource SecondaryButton}" Width="45" Height="38" Padding="0"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding MonthsInYear}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding MonthName}" Width="110" FontSize="15"
                                                           FontWeight="SemiBold" Margin="0,0,10,0"
                                                           VerticalAlignment="Top" Foreground="#2c3e50"/>
                                                <ItemsControl ItemsSource="{Binding Days}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="30" Height="30" Margin="2" CornerRadius="4"
                                                                    Background="{Binding IsPaid, Converter={StaticResource BoolToColorConverter}}">
                                                                <TextBlock Text="{Binding DayNumber}" FontSize="12"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Tipovi članarina" Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding MembershipTypeViewModel}" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tipovi članarina" Style="{StaticResource SectionTitle}"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding Types}"
                                  SelectedItem="{Binding SelectedType}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naziv" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Cena (RSD)" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="Trajanje (dana)" Binding="{Binding DurationInDays, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="➕ Dodaj" Command="{Binding AddTypeCommand}"
                                Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                        <Button Content="💾 Sačuvaj izmene" Command="{Binding SaveTypeCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                        <Button Content="🗑️ Obriši" Command="{Binding DeleteTypeCommand}"
                                Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Oprema" Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding GymEquipmentViewModel}" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Oprema teretane" Style="{StaticResource SectionTitle}"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding Equipment}"
                                  SelectedItem="{Binding SelectedEquipment}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naziv" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Kategorija" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                <DataGridTextColumn Header="Datum nabavke" Binding="{Binding PurchaseDate, StringFormat=dd.MM.yyyy, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridCheckBoxColumn Header="Treba servis" Binding="{Binding NeedsMaintenance, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="➕ Dodaj" Command="{Binding AddEquipmentCommand}"
                                Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                        <Button Content="💾 Sačuvaj izmene" Command="{Binding SaveEquipmentCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                        <Button Content="🗑️ Obriši" Command="{Binding DeleteEquipmentCommand}"
                                Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Članarine">
                <Grid DataContext="{Binding MembershipViewModel}" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Članarine" Style="{StaticResource SectionTitle}"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <ComboBox Width="200" Margin="0,0,10,0" Height="36" FontSize="14"
                                      ItemsSource="{Binding AllMembers}"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="FullName"
                                      SelectedItem="{Binding NewMember}"/>
                            <ComboBox Width="170" Margin="0,0,10,0" Height="36" FontSize="14"
                                      ItemsSource="{Binding AllTypes}"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding NewType}"/>
                            <DatePicker Width="140" Margin="0,0,10,0" Height="36" FontSize="14"
                                        VerticalContentAlignment="Center"
                                        SelectedDate="{Binding NewStartDate}"/>
                            <Button Content="➕ Dodaj članarinu" Command="{Binding AddMembershipCommand}"
                                    Style="{StaticResource SuccessButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding Memberships}"
                                  SelectedItem="{Binding SelectedMembership}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Član" Binding="{Binding Member.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Tip" Binding="{Binding MembershipType.Name}" Width="150"/>
                                <DataGridTextColumn Header="Početak" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Ističe" Binding="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Button Grid.Row="3" Content="🗑️ Obriši" Command="{Binding DeleteMembershipCommand}"
                            Style="{StaticResource DangerButton}" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>